<?xml version="1.0" encoding="utf-8"?>
<!-- AlarmActivity: the full-screen ringing screen, locked or unlocked. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07080D">

    <View
        android:id="@+id/alarm_sunrise"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/alarm_sunrise" />

    <LinearLayout
        android:id="@+id/alarm_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="120dp"
        android:paddingBottom="56dp">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:fontFamily="sans-serif-light"
            android:textColor="#FFFFFF"
            android:textSize="96sp" />

        <TextView
            android:id="@+id/alarm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#D9FFFFFF"
            android:textSize="22sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/alarm_snooze"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/alarm_snooze_bg"
            android:stateListAnimator="@null"
            android:text="Snooze"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/alarm_stop"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/alarm_stop_bg"
            android:stateListAnimator="@null"
            android:text="Stop"
            android:textAllCaps="false"
            android:textColor="#07080D"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>
